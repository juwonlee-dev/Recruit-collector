# 복사해서 .env 로 사용하세요 (docker compose가 읽음). .env는 git에 올리지 않습니다.
POSTGRES_PASSWORD=change-me
# HTTPS 인증서를 받을 도메인 (Let's Encrypt)
DOMAIN=
# 인증서 계정 연락처 (선택). 비우면 이메일 없이 등록
LETSENCRYPT_EMAIL=
# POSTGRES_PORT=5432   # 이 PC에서 DB에 접속할 포트 (이관·백업용, 외부에는 열리지 않음)
# HTTP_PORT=8765       # nginx HTTP (공유기 외부 80을 이 포트로)
# HTTPS_PORT=8766      # nginx HTTPS (공유기 외부 443을 이 포트로)
# ZeroSSL로 받을 때: ZeroSSL 대시보드 > Developer > EAB Credentials 값 (비우면 Let's Encrypt)
ZEROSSL_EAB_KID=
ZEROSSL_EAB_HMAC_KEY=
# 연봉·인원 보조 자료 (조회 서버 app이 씀). 비우면 해당 자료 없이 올댓컴퍼니만 씀
# 공공데이터포털 > 마이페이지 > 데이터활용 > '국민연금공단_국민연금 가입사업장 정보'의 일반 인증키(Decoding) 값
DATA_GO_KR_SERVICE_KEY=
# OpenDART(opendart.fss.or.kr) > 인증키 관리 의 API 인증키 (40자리)
OPENDART_API_KEY=
